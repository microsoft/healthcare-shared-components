<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- When <clear /> is present, previously defined sources are ignored -->
    <clear />
    <add key="shared-packages" value="https://microsofthealthoss.pkgs.visualstudio.com/HealthcareSharedComponents/_packaging/Packages/nuget/v3/index.json" />
    <add key="fhir-public" value="https://microsofthealthoss.pkgs.visualstudio.com/FhirServer/_packaging/Public/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="shared-packages">
      <package pattern="*" />
    </packageSource>
    <packageSource key="fhir-public">
      <package pattern="Microsoft.Health.*" />
      <package pattern="Mseng.Sql.Dac" />
    </packageSource>
  </packageSourceMapping>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
